{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "flux",
    "kubernetes"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "(^|/)apps/.*\\.ya?ml$/",
      "(^|/)infrastructure/.*\\.ya?ml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "(^|/)apps/.*\\.ya?ml$/",
      "(^|/)infrastructure/.*\\.ya?ml$/"
    ]
  }
}
