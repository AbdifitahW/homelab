{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "description": [
    "Runs early Monday morning once a week"
  ],
  "schedule": [
    "* 0-3 * * 1"
  ],
  "enabledManagers": [
    "flux",
    "kubernetes"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps/.*\\.yaml$/",
      "/^infrastructure/.*\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/^apps/.*\\.yaml$/",
      "/^infrastructure/.*\\.yaml$/"
    ]
  }
}
